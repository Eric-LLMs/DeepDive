flowchart TB
    subgraph Clients
        web[React Web UI]
        desk[Electron Workbench]
    end
    subgraph API["FastAPI gateway"]
        kernel[AgentKernel]
        router["/api/research router<br/>projects · inbox · status"]
        rplugin["research Cordis plugin<br/>6 tools + ResearchService"]
        approve[approval bridge<br/>human-in-the-loop]
    end
    subgraph Worker["arq worker"]
        ingest[asset_ingest<br/>RAG index]
        job[research job handlers<br/>optional heavy steps]
    end
    subgraph Stores
        pg[("PostgreSQL<br/>Metadata, Graph Nodes/Edges, Entity State")]
        obj[("Object Store / Disk<br/>Artifact Binary / Markdown Payloads<br/>SHA-256 dedup")]
        scratch[research_scratch dir<br/>ephemeral cache]
        rag[RAG index<br/>pgvector + tsvector]
    end

    web --> router
    desk --> router
    router --> kernel
    kernel --> rplugin
    rplugin --> approve
    rplugin -->|"DomainService<br/>save_artifact / graph / state"| pg
    rplugin -->|"bytes"| obj
    rplugin -->|"scratch IO"| scratch
    pg -->|"READY asset"| ingest
    ingest --> rag
    rplugin -->|"enqueue"| job
    job --> pg
