# ── Database ──
DATABASE_URL=postgresql+asyncpg://deepgloss:deepgloss@localhost:5432/deepgloss

# ── Redis ──
REDIS_URL=redis://localhost:16379/0

# ── LLM (via LiteLLM gateway or direct) ──
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Embedding ──
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── TTS (leave TTS_API_KEY/TTS_BASE_URL empty to fall back to LLM config) ──
TTS_API_KEY=sk-xxx
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1-hd
TTS_VOICE=alloy
# Free edge-tts fallback voice (used when the OpenAI-compatible TTS has no key or fails)
EDGE_TTS_VOICE=en-US-AvaNeural

# ── STT ──
STT_MODEL=whisper-1

# ── JWT / Auth ──
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Cache paths ──
AUDIO_CACHE_PATH=./data/audio_cache
IMAGE_CACHE_PATH=./data/image_cache
