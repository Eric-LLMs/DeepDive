# ── Database ──
DATABASE_URL=postgresql+asyncpg://deepgloss:deepgloss@localhost:5432/deepgloss

# ── Redis ──
REDIS_URL=redis://localhost:16379/0

# ── LLM (via LiteLLM gateway) ──
LLM_API_KEY=sk-local-gateway
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=deepgloss-chat

# ── LLM upstream (consumed by the LiteLLM gateway container) ──
LITELLM_MASTER_KEY=sk-local-gateway
LLM_UPSTREAM_MODEL=openai/gpt-4o-mini
LLM_UPSTREAM_BASE=https://api.openai.com/v1
LLM_UPSTREAM_KEY=sk-xxx

# ── Embedding (TEI service) ──
EMBEDDING_BASE_URL=http://localhost:8080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── HuggingFace endpoint (used for model downloads inside the TEI containers) ──
# Leave unset to use the official huggingface.co. On a slow/blocked network, set a mirror
# in your local .env (gitignored, never committed), e.g. HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=https://huggingface.co

# ── TTS (Kokoro-FastAPI service) ──
TTS_BASE_URL=http://localhost:8880/v1
TTS_API_KEY=not-needed
TTS_MODEL=kokoro
TTS_VOICE=am_michael

# ── STT ──
STT_MODEL=whisper-1

# ── Retrieval capability seam ──
# in_process (RAG pipeline inside the API) | grpc (retrieval service)
RETRIEVAL_MODE=in_process
RETRIEVAL_GRPC_ADDR=localhost:15051

# ── JWT / Auth ──
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Cache paths ──
AUDIO_CACHE_PATH=./data/audio_cache
IMAGE_CACHE_PATH=./data/image_cache
