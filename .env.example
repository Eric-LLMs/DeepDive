# ── Database ──
DATABASE_URL=postgresql+asyncpg://deepdive:deepdive@localhost:15432/deepdive

# ── Redis ──
REDIS_URL=redis://localhost:16379/0

# ── LLM ── provider/key/model are configured in the admin panel (stored in the DB), not here.

# ── Embedding (TEI service) ──
EMBEDDING_BASE_URL=http://localhost:18080
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── HuggingFace endpoint (used for model downloads inside the TEI containers) ──
# Leave unset to use the official huggingface.co. On a slow/blocked network, set a mirror
# in your local .env (gitignored, never committed), e.g. HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=https://huggingface.co

# ── TTS (Kokoro-FastAPI service) ──
TTS_BASE_URL=http://localhost:18880/v1
TTS_API_KEY=not-needed
TTS_MODEL=kokoro
TTS_VOICE=am_michael

# ── STT ──
STT_MODEL=whisper-1

# ── Social search (search_social plugin) ──
# reddit: all four set → official oauth.reddit.com API (reliable live path); unset → anonymous
#         www.reddit.com/search.json (frequently 403 from datacenter IPs). Free *script* app
#         creds from https://www.reddit.com/prefs/apps (requires Reddit Data API approval).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# x: X API v2 bearer token — required to enable the `x` platform (free public API is gone).
X_BEARER_TOKEN=

# ── Retrieval capability seam ──
# in_process (RAG pipeline inside the API) | grpc (retrieval service)
RETRIEVAL_MODE=in_process
RETRIEVAL_GRPC_ADDR=localhost:15051

# ── Worker (arq) ──
WORKER_CONCURRENCY=10
WORKER_JOB_TIMEOUT=3600

# ── Bash sandbox (agent `bash` tool) ──
# docker (default): each command runs in a fresh one-shot container via docker-py.
# host: local-process fallback — LOCAL DEVELOPMENT ONLY, NOT a security boundary.
#       Requires Docker to be installed regardless; opt in explicitly for local debugging.
BASH_SANDBOX=docker
BASH_SANDBOX_IMAGE=debian:bookworm-slim
BASH_SANDBOX_NETWORK=false
BASH_SANDBOX_MEM_LIMIT=512m
BASH_SANDBOX_CPUS=0.5
BASH_SANDBOX_TIMEOUT=30

# ── Auth (opaque server-side tokens; no JWT) ──
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Anonymous guests may chat without an account, capped per day (-1 = unlimited).
GUEST_DAILY_LIMIT=10
# Fixed-window auth rate limits (per client IP, redis INCR+EXPIRE). 0 disables a limit.
AUTH_LOGIN_RPM=30          # /auth/login + /auth/session-login
AUTH_REGISTER_RPM=10       # /auth/register
AUTH_RECOVERY_RPM=5        # /auth/forgot-password / /auth/reset-password / /auth/resend-verification
AUTH_RATE_LIMIT_WINDOW=60  # counter window in seconds
# Fail fast at startup if JWT_SECRET is left at the insecure default "change-me".
# Off by default so zero-config local startup keeps working.
ENFORCE_SECURE_SECRETS=false

# ── Cache paths ──
AUDIO_CACHE_PATH=./data/audio_cache
IMAGE_CACHE_PATH=./data/image_cache

# ── Cloud drive (per-user file store + shared RAG corpus) ──
OBJECT_STORE_ROOT=./data/objects   # sharded physical object store
DRIVE_CHUNK_SIZE=8388608           # default upload chunk size (bytes; 8 MiB)
DRIVE_MAX_CHUNKS=1024              # max chunks per upload (8 MiB x 1024 → 8 GiB)
DRIVE_MAX_FILE_SIZE=0              # max upload bytes, 0 = unlimited
INGEST_CHUNK_CHARS=1200            # RAG chunk target length (chars)
INGEST_CHUNK_OVERLAP=150           # RAG chunk overlap (chars)
EMBED_BATCH_SIZE=16                # embeddings per batch during ingest

# ── Research OS auto-run (T0: one-click Run → server-side worker chain to PUBLISH) ──
RESEARCH_SCRATCH_DIR=./data/research_scratch  # file-backed task state root
RESEARCH_DRIVER_MAX_TURNS=8        # max chained worker turns before the run must pause for a human
RESEARCH_DRIVER_MAX_NO_PROGRESS_TURNS=2  # consecutive no-progress turns → STALLED
RESEARCH_DRIVER_TURN_MAX_STEPS=25  # per worker-turn LLM step cap (interactive stays at 5)
RESEARCH_DRIVER_MAX_ATTEMPTS=3     # transient retries per turn_index (turn_attempt cap)
# RESEARCH_DRIVER_MAX_COST_USD=     # cumulative auto-run cost cap; unset = unlimited

# ── Runtime logging (packages/core/logger.py) ──
LOG_LEVEL=INFO                      # root logger level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_DIR=./logs                      # rotating logs: <LOG_DIR>/api.log and <LOG_DIR>/worker.log
LOG_FILE_MAX_BYTES=10485760         # single log file cap before rotation (10 MiB)
LOG_FILE_BACKUPS=5                  # rotated log files kept per process
